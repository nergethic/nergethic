<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>OneOf.Monads</id>
    <version>1.21.0</version>
    <authors>Erik Svensson</authors>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <description>This library adds common monads to the fantastic OneOf union type library.</description>
    <copyright>Erik Svensson</copyright>
    <repository url="https://github.com/svan-jansson/OneOf.Monads" />
    <dependencies>
      <group targetFramework=".NETStandard2.0">
        <dependency id="OneOf" version="3.0.223" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>